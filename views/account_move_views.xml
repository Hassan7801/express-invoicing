<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_express" model="ir.ui.view">
        <field name="name">account.move.form.express.invoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_express_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="express_picking_count == 0 or move_type not in ('out_invoice', 'out_refund')">
                    <field name="express_picking_count" widget="statinfo" string="Delivery"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="tracking" column_invisible="1"/>
                <field name="lot_id"
                       optional="show"
                       options="{'no_create': True}"
                       domain="[('product_id', '=', product_id)]"
                       context="{'default_product_id': product_id, 'default_company_id': parent.company_id}"
                       required="tracking in ('lot', 'serial')"
                       invisible="tracking not in ('lot', 'serial')"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       groups="stock.group_production_lot"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="is_express" invisible="1"/>
                <field name="express_sale_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
