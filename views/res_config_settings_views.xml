<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.express.invoicing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Express Invoicing" name="express_invoicing_settings">
                    <setting id="express_warehouse" help="Warehouse used when confirming a customer invoice creates the sales order and delivery.">
                        <field name="express_warehouse_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
